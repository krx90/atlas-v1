# Copy -- do not rename -- this file to `creds.env` and fill it in:
#
#   cp creds.env.example creds.env && chmod 600 creds.env
#
# `creds.env` is gitignored; this template is committed so the required keys
# stay self-documenting. Renaming rather than copying deletes the template.
#
# Paper-account keys: https://app.alpaca.markets/paper/dashboard/overview
# The paper key id starts with "PK". A key starting with "AK" is a live-trading
# key and Atlas will refuse to start with one.

APCA_API_KEY_ID=PK000000000000000000
APCA_API_SECRET_KEY=your_secret_key_here
APCA_API_PAPER=true

# Optional. A HuggingFace token only raises download throughput and anonymous
# rate limits while fetching Kronos weights for the first time. Once they are
# cached, Atlas loads with local_files_only and never contacts the hub, so the
# token goes unused. Worth setting on a fresh machine or a rate-limited network.
# Create one at https://huggingface.co/settings/tokens -- read access is enough.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
